model jenis_supplier {
  id_supplier                                               String                  @id(map: "pk_jenis_supplier") @db.VarChar(10)
  jenis_supplier                                            String                  @db.VarChar(50)
  nama_supplier                                             String                  @db.VarChar(100)
  id_admin                                                  String                  @db.VarChar(10)
  admin                                                     admin                   @relation(fields: [id_admin], references: [id_admin], map: "fk_jenis_supplier_admin")
  nama_supplier_jenis_supplier_nama_supplierTonama_supplier nama_supplier           @relation("jenis_supplier_nama_supplierTonama_supplier", fields: [nama_supplier], references: [nama_supplier], map: "fk_jenis_supplier_nama")
  penerimaan_bahan_baku                                     penerimaan_bahan_baku[]
}

model karyawan_produksi {
  id_karyawanproduksi   String                  @id(map: "pk_karyawan_produksi") @db.VarChar(10)
  id_pengguna           String                  @db.VarChar(10)
  hasil_produksi        hasil_produksi[]
  jadwal_pemeriksaan_qc jadwal_pemeriksaan_qc[]
