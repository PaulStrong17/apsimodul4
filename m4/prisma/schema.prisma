}

model karyawan_qc {
  id_karyawanqc         String                  @id(map: "pk_karyawan_qc") @db.VarChar(10)
  id_pengguna           String                  @db.VarChar(10)
  hasil_pemeriksaan_qc  hasil_pemeriksaan_qc[]
