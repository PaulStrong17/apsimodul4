  jenis_supplier_jenis_supplier_nama_supplierTonama_supplier jenis_supplier[] @relation("jenis_supplier_nama_supplierTonama_supplier")
}

model owner {
  id_owner              String                  @id(map: "pk_owner") @db.VarChar(10)
  id_pengguna           String                  @db.VarChar(10)
  jadwal_pemeriksaan_qc jadwal_pemeriksaan_qc[]
