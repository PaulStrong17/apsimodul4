generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model admin {
  id_admin              String                  @id(map: "pk_admin") @db.VarChar(10)
  id_pengguna           String                  @db.VarChar(10)
  pengguna              pengguna                @relation(fields: [id_pengguna], references: [id_pengguna], map: "fk_admin_pengguna")
  bahan_baku            bahan_baku[]
  jadwal_pemeriksaan_qc jadwal_pemeriksaan_qc[]
  jadwal_produksi       jadwal_produksi[]
  jenis_supplier        jenis_supplier[]
  laporan               laporan[]
  penerimaan_bahan_baku penerimaan_bahan_baku[]
  permintaan_produk     permintaan_produk[]
  produk                produk[]
  resep                 resep[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bahan_baku {
  id_bahan              String                  @id(map: "pk_bahan_baku") @db.VarChar(10)
  nama_bahan            String                  @db.VarChar(100)
  satuan                String                  @db.VarChar(20)
  stok                  Decimal                 @default(0) @db.Decimal(10, 2)
  stok_minimum          Decimal                 @default(0) @db.Decimal(10, 2)
  id_admin              String                  @db.VarChar(10)
  admin                 admin                   @relation(fields: [id_admin], references: [id_admin], map: "fk_bahan_baku_admin")
  detail_resep          detail_resep[]
  penerimaan_bahan_baku penerimaan_bahan_baku[]
}

model detail_resep {
  id_detailresep String     @id(map: "pk_detail_resep") @db.VarChar(10)
  id_resep       String     @db.VarChar(10)
  id_bahan       String     @db.VarChar(10)
  bahan_baku     bahan_baku @relation(fields: [id_bahan], references: [id_bahan], map: "fk_detail_resep_bahan")
  resep          resep      @relation(fields: [id_resep], references: [id_resep], map: "fk_detail_resep_resep")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model hasil_pemeriksaan_qc {
  id_hasilqc              String                    @id(map: "pk_hasil_pemeriksaan_qc") @db.VarChar(10)
  tanggal_pencatatan      DateTime                  @db.Date
  jumlah_diperiksa        Int
  jumlah_lolos            Int
  jumlah_reject           Int
  keterangan              String                    @db.VarChar(255)
  id_jadwalqc             String                    @db.VarChar(10)
  id_karyawanqc           String                    @db.VarChar(10)
  id_laporan              Int?
  jenis_laporan           String?                   @db.VarChar(50)
  jadwal_pemeriksaan_qc   jadwal_pemeriksaan_qc     @relation(fields: [id_jadwalqc], references: [id_jadwalqc], map: "fk_hasil_qc_jadwalqc")
  laporan_jenis           laporan_jenis?            @relation(fields: [jenis_laporan], references: [jenis_laporan], onDelete: Restrict, map: "fk_hasil_qc_jenis_laporan")
  karyawan_qc             karyawan_qc               @relation(fields: [id_karyawanqc], references: [id_karyawanqc], map: "fk_hasil_qc_karyawanqc")
  laporan                 laporan?                  @relation(fields: [id_laporan], references: [id_laporan], onDelete: Restrict, map: "fk_hasil_qc_laporan")
  hasil_qc_hasil_produksi hasil_qc_hasil_produksi[]
  tindakan_perbaikan      tindakan_perbaikan[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model hasil_produksi {
  id_hasil                String                    @id(map: "pk_hasil_produksi") @db.VarChar(10)
  tanggal_pencatatan      DateTime                  @db.Date
  jumlah_hasil            Int
  keterangan              String                    @db.VarChar(255)
  id_jadwalproduksi       String                    @db.VarChar(10)
  id_karyawanproduksi     String                    @db.VarChar(10)
  jadwal_produksi         jadwal_produksi           @relation(fields: [id_jadwalproduksi], references: [id_jadwalproduksi], map: "fk_hasil_produksi_jadwal")
  karyawan_produksi       karyawan_produksi         @relation(fields: [id_karyawanproduksi], references: [id_karyawanproduksi], map: "fk_hasil_produksi_karyawan")
  hasil_qc_hasil_produksi hasil_qc_hasil_produksi[]
}

model hasil_qc_hasil_produksi {
  id_hasilqc           String               @db.VarChar(10)
  id_hasil             String               @db.VarChar(10)
  hasil_produksi       hasil_produksi       @relation(fields: [id_hasil], references: [id_hasil], map: "fk_hqhp_hasil")
  hasil_pemeriksaan_qc hasil_pemeriksaan_qc @relation(fields: [id_hasilqc], references: [id_hasilqc], map: "fk_hqhp_hasilqc")

  @@id([id_hasilqc, id_hasil], map: "pk_hasil_qc_hasil_produksi")
}

